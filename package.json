{
  "name": "nirbana-united-efc",
  "version": "1.0.0",
  "private": true,
  "description": "Official website and club management tool for Nirbana United EFC (eFootball Mobile club).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:netlify": "prisma generate --schema=./prisma/schema.production.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:studio": "prisma studio",
    "setup": "npm install && npx prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@netlify/blobs": "^8.0.0",
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "next": "14.2.15",
    "next-intl": "3.19.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.38",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
