// Nirbana United EFC — LOCAL DEVELOPMENT database schema (SQLite,
// file-based, zero setup). This is the schema your own PC's `npm run dev` /
// `setup-and-run.bat` always uses.
//
// For production on a serverless host (Netlify, Vercel, etc.), see
// prisma/schema.production.prisma instead — a separate file with the same
// models but a "postgresql" provider, kept in sync by hand since a single
// schema.prisma file can't target two database engines at once. Any time
// you add/change a model here, make the same change there.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Player {
  id             String   @id @default(cuid())
  // URL-friendly, human-readable identifier derived from name (e.g. "oishik-barua"),
  // used for the public profile page link so it reads as a name, not a random id,
  // and — unlike `id` — stays the same across tracker syncs as long as the name
  // doesn't change (a sync deletes and recreates every Player row with a new id).
  // Nullable only so existing rows survive the schema migration before their
  // first re-sync/save backfills it; every create/update always sets one.
  slug           String?  @unique
  name           String
  inGameId       String
  photoUrl       String?
  joinDate       DateTime
  position       String // e.g. Striker, Midfielder, Winger, Goalkeeper, Captain
  divisionRank   String // e.g. "Division 1", "Elite Division"
  goals          Int      @default(0)
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  // The player's current squad slot on the tracker, e.g. "Main #28" — sourced
  // straight from the tracker's own jersey-number badge on the Squad tab, so
  // it's tracker-authoritative (like goals/matches/wins) and not admin-edited.
  squadNumber    String?
  // This season's aggregate stats (currently "eFootball 2026" — whatever the
  // tracker's active season is), refreshed on every sync. Nullable because a
  // brand-new player may have no season form yet. These exist so the profile
  // page can chart "this season vs career" without re-parsing the bio text.
  seasonMatchesPlayed Int?
  seasonWins          Int?
  seasonGoalsFor      Int?
  seasonGoalsAgainst  Int?
  seasonWinPct        Float?
  seasonGoalDiff      Int?
  squadJson      String   @default("[]") // JSON string array of in-game squad card names
  favoritePlayer String? // highlighted favorite card, e.g. "Messi"
  favoritePlayerImage String?
  bio            String?
  featured       Boolean  @default(false) // show on homepage highlights
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One row per player per sync, capturing their cumulative career totals at
// that moment — the raw material for a real "trend over time" chart on the
// profile page. Keyed by `inGameId`, not the Player's `id`: every sync
// deletes and recreates all Player rows (see trackerSync.ts), so an `id`
// foreign key would break every time; `inGameId` is the one thing that
// actually stays stable for the same real person across syncs.
//
// A new row is only written when a player's totals actually changed since
// their last snapshot (see trackerSync.ts) — so this fills in gradually,
// sync by sync, rather than all at once. There is no way to backfill a
// history that was never recorded, so a brand-new player (or one added
// before this feature existed) will show "not enough history yet" on their
// profile until a couple of real syncs have passed.
model PlayerStatSnapshot {
  id            String   @id @default(cuid())
  inGameId      String
  playerName    String // denormalized for convenience/debugging only
  takenAt       DateTime @default(now())
  matchesPlayed Int
  wins          Int
  draws         Int
  losses        Int
  goals         Int

  @@index([inGameId, takenAt])
}

model Match {
  id             String   @id @default(cuid())
  opponent       String
  opponentCrest  String?
  date           DateTime
  ourScore       Int?
  opponentScore  Int?
  status         String   @default("UPCOMING") // "UPCOMING" | "COMPLETED"
  competition    String? // e.g. "Friendly", "Weekly League", "Cup Match"
  notes          String?
  // The tracker's own numeric match-report id (".../match/?id=59219").
  // trackerSync.ts reads this straight off whichever of the tracker's two
  // tabs currently shows the match: the Fixtures tab (a fixture's own
  // `<a href>`) while it's still upcoming, or the Rounds tab (an
  // `onclick="location.href='...'"` on that round's card, not a plain
  // `<a href>` — easy to miss) once it's completed. Either way it's
  // carried forward here so a re-sync never loses it, since every sync
  // fully replaces this table (matched on opponent+date — see
  // trackerSync.ts). The Rounds tab only ever shows a limited recent
  // window of completed matches, though (its own "All (N)" filter caps
  // out) — a match old enough to have scrolled out of that window, and
  // that was also never seen while upcoming, has no automatic way to get
  // one. An admin can still paste one in by hand from `/admin/matches` if
  // they can find that match's own link on cobegbd.com (see the
  // `cobegMatchId` field in lib/validation.ts's matchSchema) — see
  // lib/matchReportSync.ts.
  cobegMatchId   Int?     @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A cached copy of one match's full detail-page scrape (per-player stats,
// aggregate team stats, Man of the Match) from the tracker's own
// ".../match/?id=N" page — see lib/matchReportSync.ts. Keyed by the
// tracker's own match id (not Match.id, which is regenerated every sync)
// so the cache survives every future re-sync untouched. Fetched once, right
// after a match's Match row first turns COMPLETED with a known
// cobegMatchId, and never re-fetched afterwards — a finished match's stats
// don't change on the tracker.
model MatchReport {
  cobegMatchId Int      @id
  dataJson     String // the full parsed MatchReportData shape, JSON-encoded
  fetchedAt    DateTime @default(now())
}

// One admin-uploaded "highlight" photo for a single player — a screenshot
// of a great moment, tagged (optionally) to a specific match. Keyed by
// `inGameId`, not a Player relation: every sync deletes and recreates every
// Player row (see trackerSync.ts), so a real foreign key would break on the
// very next sync — same reasoning as PlayerStatSnapshot above. The match
// tag is fully denormalized (opponent/date/score/competition as of upload
// time) rather than a Match relation, for the same reason — Match rows are
// also fully replaced on every sync.
model PlayerHighlight {
  id               String   @id @default(cuid())
  inGameId         String
  playerName       String // denormalized for admin convenience/debugging only
  imageUrl         String
  caption          String?
  matchOpponent    String? // set only when the admin tagged this to a specific match
  matchDate        DateTime?
  matchScore       String? // e.g. "5-1", denormalized at upload time
  matchCompetition String?
  uploadedDate     DateTime @default(now())

  @@index([inGameId])
}

model News {
  id            String   @id @default(cuid())
  title         String
  body          String
  imageUrl      String?
  publishedDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Standing {
  id        String  @id @default(cuid())
  teamName  String
  position  Int
  points    Int     @default(0)
  played    Int     @default(0)
  won       Int     @default(0)
  drawn     Int     @default(0)
  lost      Int     @default(0)
  isUs      Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(cuid())
  imageUrl     String
  caption      String?
  uploadedDate DateTime @default(now())
}

// Singleton row (id is always "main") holding editable club-info/about text.
model ClubInfo {
  id          String   @id @default("main")
  clubName    String   @default("Nirbana United EFC")
  tagline     String   @default("Meditate. Dominate. Celebrate.")
  founded     String   @default("2025")
  history     String   @default("")
  achievementsJson String @default("[]") // JSON string array of achievement strings
  // Set every time runTrackerSync() finishes successfully (manual button click
  // or the automatic hourly background sync — see lib/autoSync.ts) — never by
  // hand. Lets the admin dashboard show "Last synced: X ago" so the admin can
  // see the automatic sync is actually running without watching a terminal.
  // Null only until the very first successful sync since this field existed.
  lastSyncedAt DateTime?
  // The tracker's own current-season label (e.g. "Season 2026"), read fresh
  // off the Match Stats tab on every sync (see parseSeasonLabel in
  // trackerSync.ts) — never hand-typed, so it moves forward on its own once
  // the tracker rolls over to a new season. Used for the "Season" toggle on
  // the downloadable player stat card (see PlayerStatCard.tsx); null until
  // the first sync since this field existed, or if that tab's layout ever
  // changes enough that the label can't be found.
  currentSeasonLabel String?
  updatedAt   DateTime @updatedAt
}

// One row per entry in the tracker's Transfers tab. Fully replaced on every
// sync (the tracker is the only source for this — nothing here is admin-edited).
model Transfer {
  id        String   @id @default(cuid())
  date      DateTime
  type      String // "NEW_REGISTER" | "TRANSFER" | "UNREGISTER"
  player    String
  squad     String // e.g. "Main #13"
  fromClub  String? // only set when the tracker names a previous club
  order     Int // preserves the tracker's own display order (ties can share a date)
  createdAt DateTime @default(now())
}

// One row per scope (All-Time + each season) from the tracker's Rankings
// tab — a periodic snapshot, fully replaced on every sync.
model RankingSnapshot {
  id           String   @id @default(cuid())
  scope        String // e.g. "All-Time", "eFootball 2026"
  position     Int
  division     String
  rating       Float
  played       Int
  wins         Int
  draws        Int
  goalsFor     Int
  goalsAgainst Int
  winPct       Float
  order        Int // preserves the tracker's own display order (All-Time first, then seasons)
  updatedAt    DateTime @updatedAt
}

// One row per visitor comment on a news post or a gallery photo. Every
// comment must be tagged with a real squad member's name (chosen from the
// roster via the @ picker in components/CommentBox.tsx) so there's no truly
// anonymous comment — but nothing here is tied to a real login account (the
// public site has no visitor accounts), so the name is self-declared, not
// authenticated; the server only checks that it matches a current player's
// name, not that the person typing it actually IS that player. New comments
// start PENDING and stay invisible to the public until an admin approves
// them from /admin/comments — see app/api/comments/route.ts.
model Comment {
  id         String    @id @default(cuid())
  targetType String // "NEWS" | "GALLERY"
  targetId   String // News.id or GalleryImage.id
  authorName String // the @-selected player's name, e.g. "Oishik Barua"
  body       String
  status     String    @default("PENDING") // "PENDING" | "APPROVED"
  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@index([targetType, targetId, status])
}

// One row per event a site visitor might want to know about — a completed
// match result, a newly-scheduled fixture, or a published news post. Fed
// automatically: trackerSync.ts writes a MATCH_RESULT/UPCOMING_FIXTURE row
// only for a result/fixture that's genuinely new since the last sync (see
// its own comment for how "new" is judged), and the news API route writes a
// NEWS row whenever an admin publishes a post. Nothing here is ever
// admin-edited, and it's public read-only data (see app/api/notifications) —
// there's no per-account "read" state since the public site has no visitor
// accounts; the bell icon tracks "seen" per-browser instead.
model Notification {
  id        String   @id @default(cuid())
  type      String // "MATCH_RESULT" | "UPCOMING_FIXTURE" | "NEWS"
  title     String
  body      String
  href      String? // where clicking the notification should go, if anywhere
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per page view on the public site, for the admin-only visitor
// analytics page (/admin/analytics). Written by app/api/track/route.ts,
// which the client-side VisitTracker component pings on first load and on
// every client-side route change (admin pages are never tracked). Never
// admin-edited or shown to the public — this is purely for the club owner
// to see how many people are finding the site.
//
// `visitorId` comes from a long-lived (~2 year) anonymous cookie set by the
// same route the first time a browser is seen, so repeat visits by the same
// browser can be counted ("how many times") without any login — it does
// not identify a real person by itself. `ipAddress`/`country`/`city` come
// from Netlify's own request headers (x-nf-client-connection-ip / x-nf-geo)
// when running on Netlify, and are best-effort/null in local dev. Kept as
// its own append-only log (never updated in place) so the dashboard's
// totals and trends are always exact sums over real rows.
model SiteVisit {
  id         String   @id @default(cuid())
  visitorId  String // anonymous cookie id — same value across a browser's repeat visits
  path       String // e.g. "/en/players" (locale-prefixed, as the visitor actually requested it)
  locale     String?
  ipAddress  String?
  country    String?
  countryCode String?
  city       String?
  userAgent  String?
  browser    String?
  os         String?
  deviceType String? // "desktop" | "mobile" | "tablet" | "bot" | "unknown"
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
  @@index([path])
}
