# Copy this file to .env and fill in real values before running the app.

# SQLite for local/dev. For production behind Vercel (ephemeral filesystem),
# point this at a hosted Postgres/MySQL/libSQL URL instead and change the
# provider in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-this-with-a-long-random-string"

# The very first admin account. Used only by prisma/seed.ts to create the
# first login — change the password immediately after your first login,
# and feel free to remove these two lines from .env afterwards.
ADMIN_EMAIL="admin@nirbanaunited.club"
ADMIN_PASSWORD="ChangeMe123!"
