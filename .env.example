# Copy this file to .env and fill in real values before running the app.
# This file (.env) is for LOCAL DEVELOPMENT ONLY, on your own PC — it is
# never uploaded to GitHub (see .gitignore) and has nothing to do with your
# live Netlify site. Netlify's environment variables are set separately, in
# the Netlify dashboard (Site settings -> Environment variables) — see
# GITHUB-SETUP.md / README.md for the Netlify deployment steps.

# SQLite for local/dev — a single file on your own PC, zero setup.
# On Netlify, DATABASE_URL is instead set in the Netlify dashboard to your
# Netlify Database's Postgres connection string (see
# prisma/schema.production.prisma, which is what Netlify's build uses).
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Reuse this SAME value on Netlify (don't generate a second one) — see
# CREDENTIALS.md for your current value.
SESSION_SECRET="replace-this-with-a-long-random-string"

# The very first admin account. Used only by prisma/seed.ts to create the
# first login — change the password immediately after your first login,
# and feel free to remove these two lines from .env afterwards.
ADMIN_EMAIL="admin@nirbanaunited.club"
ADMIN_PASSWORD="ChangeMe123!"

# Netlify only — not used locally at all. A random shared-secret string
# that lets Netlify's hourly scheduled sync function
# (netlify/functions/hourly-sync.mts) call your site's own
# /api/internal/scheduled-sync endpoint without needing an admin login.
# Generate one the same way as SESSION_SECRET above, and set it in the
# Netlify dashboard only (see CREDENTIALS.md for your current value).
SYNC_SECRET="replace-this-with-a-second-long-random-string"
